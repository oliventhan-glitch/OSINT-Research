98f5c1791499&quot;,null,null,null,null,null,null,1,null,null,null,0]];mutable:true"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4180859737="" role="img" fonticon="content_copy" class="mat-icon notranslate gds-icon-m action-button-icon google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="content_copy"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><!----><!----><!----><span _ngcontent-ng-c4180859737="" class="user-query-bubble-with-background enable-2026q1-formatting-improvements ng-star-inserted"><!----><span _ngcontent-ng-c4180859737="" class="horizontal-container"><div _ngcontent-ng-c4180859737="" role="heading" aria-level="2" class="query-text gds-body-l collapsed" dir="ltr"><span _ngcontent-ng-c4180859737="" class="cdk-visually-hidden screen-reader-user-query-label">You said</span><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹[PAGE 1: TITLE PAGE] <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Copyright Â© 2026 by Jeyapalan Oliventhan. All rights reserved. This research paper is intended for educational purposes only. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹OSINT: The Power of Open Source Intelligence in Cybersecurity <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹A Comprehensive Research on Digital Reconnaissance <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Author: Jeyapalan Oliventhan (AKJ) <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Founder: Oli Creatives <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Date: April 2026 <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹[PAGE 2: INTRODUCTION] <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹What is OSINT? <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Open Source Intelligence (OSINT) is the practice of collecting and analyzing information that is publicly available. In the world of Ethical Hacking, it is the first and most crucial stepâ€”Reconnaissance. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Why it matters? <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Before an attacker or a defender makes a move, they need information. OSINT helps in identifying potential vulnerabilities, leaked credentials, and hidden digital footprints. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹[PAGE 3: THE TOOLS &amp; TECHNIQUES] <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹1. Username Tracking (Sherlock) <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Finding a target across social media platforms using a single username. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Command: python3 sherlock username <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹2. Email &amp; Domain Intelligence (TheHarvester) <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Gathering emails, subdomains, and hostnames to map an organization's structure. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Command: theHarvester -d domain.com -b google <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹3. Image Metadata Analysis (Exiftool) <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Extracting hidden data (GPS coordinates, device info) from images. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Command: exiftool image.jpg <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹4. Google Dorking <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Using advanced search operators to find hidden files like index of / or filetype:pdf. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹[PAGE 4: HRM &amp; CYBERSECURITY] <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹The Human Element (HRM Perspective): <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> As an HRM enthusiast, I believe security is not just about codeâ€”it's about people. OSINT reveals how employeesâ€™ public data can be used in Social Engineering attacks. Training staff to manage their digital footprint is a key part of modern HR management. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹[PAGE 5: CONCLUSION &amp; LEGAL] <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Conclusion: <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> OSINT is a double-edged sword. While it can be used for malicious purposes, its true power lies in helping security professionals build stronger defenses. <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Contact Info: <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹LinkedIn:https://lk.linkedin.com/in/oliventhan-undefined-2987ba405 <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> X (Twitter): https://x.com/Oliventhan2007 <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Agency: Oli Creatives <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> â€‹Â© 2026 Jeyapalan Oliventhan. Licensed under CC BY-NC-SA 4.0 <!----><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"><!----><br _ngcontent-ng-c4180859737="" class="ng-star-inserted"><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"><!----><br _ngcontent-ng-c4180859737="" class="ng-star-inserted"><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"><!----><br _ngcontent-ng-c4180859737="" class="ng-star-inserted"><!----></p><p _ngcontent-ng-c4180859737="" class="query-text-line ng-star-inserted"> Plz Mack as a pdf <!----><!----></p><!----></div><button _ngcontent-ng-c4180859737="" mat-icon-button="" aria-label="Expand" mattooltip="Expand text" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-mdc-tooltip-trigger expand-button mat-unthemed ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" jslog="224552;track:generic_click,impression;BardVeMetadataKey:[[&quot;r_fa29b33cc6f28d08&quot;,&quot;c_68bc98f5c1791499&quot;,null,null,null,null,null,null,1,null,null,null,0]];mutable:true" aria-describedby="cdk-describedby-message-ng-1-22" cdk-describedby-host="ng-1"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><mat-icon _ngcontent-ng-c4180859737="" role="img" fonticon="expand_more" class="mat-icon notranslate gds-icon-l google-symbols mat-ligature-font mat-icon-no-color" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="expand_more"></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-targe